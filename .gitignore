# IDEA 的本机配置不随项目提交，避免混入绝对路径和运行环境变量。
.idea/
*.iml

# 只提交配置模板；真实账号、密钥和本地日志保留在开发机。
.env
.env.*
!.env.example
*.log

# 文档契约校验使用独立工具环境，不进入产品依赖。
.contract-venv/
scripts/__pycache__/

# AI 工具的本机会话配置与文档预览缓存。
.claude/
.preview/
.workbuddy/
.slidep/

# 交付轮次的临时截图不随项目提交；各工程依赖目录由各端自行管理。
temp/
node_modules/

# 实验导出的学生数据与论文素材，只留本机（口径见 docs/features/experiment-protocol.md）。
.cache/
experiments/
