<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learningplatform.modules.auth.mapper.AuthSessionMapper">
    <resultMap id="session" type="com.learningplatform.modules.auth.model.AuthSession">
        <constructor>
            <idArg name="id" column="id" javaType="java.lang.String"/>
            <arg name="userId" column="user_id" javaType="java.lang.String"/>
            <arg name="tokenHash" column="token_hash" javaType="java.lang.String"/>
            <arg name="credentialHash" column="credential_hash" javaType="java.lang.String"/>
            <arg name="csrfSecret" column="csrf_secret" javaType="java.lang.String"/>
            <arg name="expiresAt" column="expires_at" javaType="java.time.Instant"
                 typeHandler="com.learningplatform.common.mybatis.UtcInstantTypeHandler"/>
            <arg name="idleExpiresAt" column="idle_expires_at" javaType="java.time.Instant"
                 typeHandler="com.learningplatform.common.mybatis.UtcInstantTypeHandler"/>
            <arg name="revokedAt" column="revoked_at" javaType="java.time.Instant"
                 typeHandler="com.learningplatform.common.mybatis.UtcInstantTypeHandler"/>
            <arg name="lastSeenAt" column="last_seen_at" javaType="java.time.Instant"
                 typeHandler="com.learningplatform.common.mybatis.UtcInstantTypeHandler"/>
            <arg name="createdAt" column="created_at" javaType="java.time.Instant"
                 typeHandler="com.learningplatform.common.mybatis.UtcInstantTypeHandler"/>
            <arg name="updatedAt" column="updated_at" javaType="java.time.Instant"
                 typeHandler="com.learningplatform.common.mybatis.UtcInstantTypeHandler"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, user_id, token_hash, credential_hash, csrf_secret, expires_at, idle_expires_at,
        revoked_at, last_seen_at, created_at, updated_at
    </sql>

    <select id="findByTokenHash" resultMap="session">
        SELECT <include refid="columns"/> FROM auth_sessions WHERE token_hash = #{tokenHash}
    </select>
    <select id="findByTokenHashForUpdate" resultMap="session">
        SELECT <include refid="columns"/> FROM auth_sessions WHERE token_hash = #{tokenHash} FOR UPDATE
    </select>

    <insert id="insert">
        INSERT INTO auth_sessions (<include refid="columns"/>)
        VALUES (#{session.id}, #{session.userId}, #{session.tokenHash}, #{session.credentialHash}, #{session.csrfSecret},
                #{session.expiresAt,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
                #{session.idleExpiresAt,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
                #{session.revokedAt,jdbcType=TIMESTAMP,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
                #{session.lastSeenAt,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
                #{session.createdAt,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
                #{session.updatedAt,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler})
    </insert>

    <update id="touch">
        UPDATE auth_sessions SET
            last_seen_at = #{now,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
            updated_at = #{now,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
            idle_expires_at = #{idleExpiresAt,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler}
        WHERE id = #{id} AND revoked_at IS NULL
    </update>
    <update id="revoke">
        UPDATE auth_sessions SET
            revoked_at = #{now,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler},
            updated_at = #{now,typeHandler=com.learningplatform.common.mybatis.UtcInstantTypeHandler}
        WHERE id = #{id} AND revoked_at IS NULL
    </update>
</mapper>
