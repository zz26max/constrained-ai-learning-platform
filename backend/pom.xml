<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程统一管理 Spring 相关依赖与构建插件版本，避免各自选版本造成冲突。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.learningplatform</groupId>
    <artifactId>learning-platform-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>learning-platform-backend</name>
    <description>个性化学习平台后端</description>

    <properties>
        <!-- 编译目标固定为 Java 21；终端与 IDEA 也应选择同一版本的 JDK。 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Argon2 实现需要 Bouncy Castle；此依赖不由 Boot BOM 管理，显式固定版本。 -->
        <bouncycastle.version>1.86</bouncycastle.version>
    </properties>

    <dependencies>
        <!-- 提供 Spring MVC、JSON 序列化和内嵌 Tomcat，使应用能够接收 HTTP 请求。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 提供 Jakarta Bean Validation；后续请求 DTO 的 @Valid、@NotBlank 等由它执行。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Boot 4 的 Flyway Starter 同时提供 JDBC 与 Hikari 连接池，启动时自动执行迁移。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 的 MySQL 支持独立成模块；版本由 Boot 父工程统一管理。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- JDBC 编译依赖标准接口；MySQL 驱动只在实际运行时需要。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis 4.0 Starter 支持 Boot 4；复用已有 DataSource，不创建第二个连接池。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- 口令哈希与 HTTP 认证过滤链：crypto 提供算法，starter 提供过滤链与配置。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- 测试依赖只在测试阶段使用，包括 JUnit Jupiter、MockMvc 和 JSON 断言。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2 的模块带 testcontainers- 前缀；测试启动真实 MySQL 8.4。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 将普通 jar 打包为可用 java -jar 独立启动的 Spring Boot 应用。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- test 跑普通测试；verify 还会执行 *IT 的真实数据库集成测试。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
