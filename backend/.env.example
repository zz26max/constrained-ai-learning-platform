# 本地启动脚本会按此模板创建被 Git 忽略的 .env，并生成随机密码。
# 手工配置时填写两个密码；这里只记录字段，不放真实密钥。
# .env 是简单的 KEY=value 格式，值不加引号；Spring Boot 本身不会自动读取它。
SPRING_PROFILES_ACTIVE=api
DB_URL=jdbc:mysql://127.0.0.1:3307/learning_platform
DB_USERNAME=learning_platform
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 仅在显式执行 -InitializeAccounts 时使用；空值由脚本随机生成，不是默认口令。
LOCAL_STUDENT_PASSWORD=
LOCAL_TEACHER_PASSWORD=
LOCAL_ADMIN_PASSWORD=

# 预登录 CSRF 签名密钥（可选；缺失时进程随机生成，仅适用于单机开发，生产必须显式配置）。
AUTH_PRE_LOGIN_SIGNING_KEY=
# 邀请码 HMAC 密钥（至少 32 字节）；启动脚本缺失时随机生成并保存在 .env。
# 此密钥需要跨进程重启保持稳定，轮换后已有邀请码将不可用；生产必须由环境显式提供。
AUTH_INVITE_SIGNING_KEY=
# 允许的浏览器 Origin，逗号分隔；开发代理不得伪造 Origin。
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# 生产 HTTPS 环境设为 true，Cookie 加 Secure；本地 HTTP 保持 false。
AUTH_COOKIE_SECURE=false

# P2 AI: external transmission requires both switches and explicit approved data/provider settings.
# 本地验证可用智谱免费模型（OpenAI 兼容）：把下面两行换成
#   AI_PROVIDER_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   AI_PROVIDER_MODEL=glm-4.7-flash
# 再用 `node scripts/ai-provider-smoke.mjs` 自检输出是否会通过受限校验。
AI_EXTERNAL_ENABLED=false
AI_DATA_APPROVED=false
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=
# 可选：智谱模型设为 disabled 可关闭深度思考，降低延迟与输出占用；留空用厂商默认。
AI_PROVIDER_THINKING=
AI_WORKER_ENABLED=true
# 实验用消融开关，逗号分隔：static,intercept_input,intercept_output,graded_hints（rag 待 L1）。
# 默认空＝全部机制生效；仅在隔离实验环境临时设置，结束后清空并重启。
AI_ABLATION_DISABLE=
AI_RETENTION_CLEANUP_ENABLED=false
HELP_RETENTION_ENABLED=false
ANALYTICS_RETENTION_ENABLED=false

# Automatic checks require Docker and locally built/pulled runner images.
# Build: docker build -t lms-web-check:1 backend/check-runner (from repository root).
CHECKS_ENABLED=false
CHECKS_WEB_IMAGE=lms-web-check:1
CHECKS_MYSQL_IMAGE=lms-sql-check:1
